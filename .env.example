# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. Never put real values here —
# .env.example is committed, .env.local is not.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Narrative wording (all optional)
#
# Every number and chart is computed locally and is correct with no keys at all.
# A key only buys nicer phrasing on the narrative and natural-language questions.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Presentation voice (optional)
#
# Without a key, the presentation is narrated by the browser's built-in speech
# synthesis — free, offline, on-device. Set ELEVENLABS_API_KEY to narrate with a
# specific ElevenLabs voice instead (this sends the anonymous narration text to
# ElevenLabs to be spoken). The voice id defaults to the one chosen for this app.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# Connector vault (optional — only needed to connect to external databases)
#
# Leave these blank and the app behaves exactly as before: files are parsed and
# analysed entirely in the browser and nothing reaches a server.
# ---------------------------------------------------------------------------

# The project API URL — NOT a Postgres connection string. Supabase dashboard ->
# Project Settings -> Data API. Anything prefixed NEXT_PUBLIC_ is inlined into
# the browser bundle, so a connection string here would ship your database
# password to every visitor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe to expose: this key is designed to be public and is gated by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret. Bypasses row-level security, so it is the only thing that can read the
# credential vault. Server-side only — never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The key that encrypts stored database credentials. Generate with:
#   openssl rand -base64 32
#
# This must NOT live in the Supabase project it protects. If the database and
# the key are compromised together, the encryption bought you nothing.
# Losing it makes every stored credential unrecoverable — they must be re-entered.
VAULT_MASTER_KEY=

# Rotation: bump the version and keep the previous key available so credentials
# wrapped under it can still be opened while they are re-wrapped.
# VAULT_MASTER_KEY_VERSION=2
# VAULT_MASTER_KEY_V1=

# ---------------------------------------------------------------------------
# Connector limits (optional)
# ---------------------------------------------------------------------------
# CONNECTOR_MAX_ROWS=50000
# CONNECTOR_QUERY_TIMEOUT_MS=30000
# Set to false for a shared, multi-tenant deployment so a user-supplied host
# cannot reach private address space.
# CONNECTOR_ALLOW_PRIVATE_HOSTS=true
